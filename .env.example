# Copy to `.env` in the project root. Values load automatically via `config.py`.
APP_TITLE=Python AI Starter Template

# OpenAI API key and model
OPENAI_API_KEY=YOUR_OPENAI_API_KEY # Get a key from, https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4o-mini # Optional; defaults to cheapest model if unset

# Optional limits (integers; omit to use defaults from config.py)
# MAX_INPUT_CHARS=500
# MAX_REQUESTS_PER_SESSION=10
# MAX_OUTPUT_TOKENS=100
